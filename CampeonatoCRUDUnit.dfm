  end
  inherited queryGrid: TZReadOnlyQuery
    SQL.Strings = (
      'select oid, nombre'
      'from campeonato '
      
        'where (:nombre is null or LENGTH(:nombre) = 0 or nombre like  CO' +
        'NCAT('#39'%'#39',:nombre,'#39'%'#39'))'
      'order by nombre')
    Params = <
      item
        DataType = ftUnknown
        Name = 'nombre'
        ParamType = ptUnknown
      end>
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'nombre'
        ParamType = ptUnknown
      end>
  end
