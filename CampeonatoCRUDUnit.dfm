  object ZExportarValores: TZQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      'select coalesce(case '
      '            when ipe.tipo_categoria_oid = 1 then p.nro_moto '
      
        '            when ipe.tipo_categoria_oid = 2 then p.nro_cuatricic' +
        'lo'
      
        '            when ipe.tipo_categoria_oid = 3 then p.nro_moto_cros' +
        's'
      
        '            end, 0) numero, p.nombre, p.apellido, c.nombre categ' +
        'oria, l.localidad, '
      '      count(e.oid) cantidad_inscripciones      '
      'from evento e'
      
        '     join inscripcion_piloto_evento ipe on ipe.evento_oid = e.oi' +
        'd,'
      '     categorias c, piloto p '
      '     join localidad l on l.oid = p.localidad_oid'
      'where e.campeonato_oid = :campeonato_oid'
      '      and ipe.piloto_oid = p.oid'
      '      and c.oid = '
      '          case '
      
        '               when ipe.tipo_categoria_oid = 1 then p.categoria_' +
        'oid '
      
        '               when ipe.tipo_categoria_oid = 2 then p.categoria_' +
        'cuatriciclos_oid'
      
        '               when ipe.tipo_categoria_oid = 3 then p.categoria_' +
        'motocross_oid'
      '           end  '
      'group by numero, nombre, apellido, categoria, localidad         '
      
        'having cantidad_inscripciones  = (select count(e1.oid) from even' +
        'to e1 where e1.campeonato_oid = :campeonato_oid)'
      'order by categoria, numero, apellido, nombre'
      '                        ')
    Params = <
      item
        DataType = ftUnknown
        Name = 'campeonato_oid'
        ParamType = ptUnknown
      end>
    Properties.Strings = (
      'codepage=utf8')
    Left = 48
    Top = 336
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'campeonato_oid'
        ParamType = ptUnknown
      end>
  end
end
