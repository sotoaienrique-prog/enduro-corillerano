  object ZROQTiempoEspera: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        'select sel_nro_moto_by_evento_and_tipo_categoria(pp.tipo_categor' +
        'ia_oid, pp.evento_oid, pp.piloto_oid) nro_moto,'
      '       CONCAT(p.apellido, '#39', '#39' , p.nombre) as nombre_piloto,'
      
        '       case when :tiempo_espera >= TIME_TO_SEC(TIMEDIFF(current_' +
        'timestamp , pp.fecha_ingreso)) '
      
        '            then TIME_FORMAT(SEC_TO_TIME(:tiempo_espera - TIME_T' +
        'O_SEC(TIMEDIFF(current_timestamp , pp.fecha_ingreso))),'#39'%i:%S'#39')'
      '            else 0 '
      '       end as segundos_espera,'
      
        '       case when  :tiempo_espera <= TIME_TO_SEC(TIMEDIFF(current' +
        '_timestamp , pp.fecha_ingreso)) '
      
        '            then TIME_FORMAT(SEC_TO_TIME(TIME_TO_SEC(TIMEDIFF(cu' +
        'rrent_timestamp , pp.fecha_ingreso)) -  :tiempo_espera),'#39'%i:%S'#39')'
      '            else 0 '
      '       end as salida,  '
      
        '       TIME_TO_SEC(TIMEDIFF(current_timestamp , pp.fecha_ingreso' +
        ')) segundos,'
      
        '       (TIME_TO_SEC(TIMEDIFF(current_timestamp , pp.fecha_ingres' +
        'o))/:tiempo_espera)*100 progreso'
      'from paradas_piloto pp'
      '     join evento e on pp.evento_oid = e.oid'
      '     join piloto p on pp.piloto_oid = p.oid'
      'where pp.evento_oid =:evento_oid'
      
        '     and TIME_TO_SEC(TIMEDIFF(current_timestamp , pp.fecha_ingre' +
        'so)) < (:tiempo_espera+ :tiempo_permanencia)'
      'order by pp.oid     ')
    Params = <
      item
        DataType = ftInteger
        Name = 'tiempo_espera'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'evento_oid'
        ParamType = ptInput
        Value = '1'
      end
      item
        DataType = ftInteger
        Name = 'tiempo_permanencia'
        ParamType = ptInput
      end>
    Left = 312
    Top = 136
    ParamData = <
      item
        DataType = ftInteger
        Name = 'tiempo_espera'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'evento_oid'
        ParamType = ptInput
        Value = '1'
      end
      item
        DataType = ftInteger
        Name = 'tiempo_permanencia'
        ParamType = ptInput
      end>
  end
  object DSTiempoEspera: TDataSource
    DataSet = ZROQTiempoEspera
    Left = 352
    Top = 136
  end
  object ZEvento: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        'select e.oid, CONCAT(e.nro_fecha, '#39' - '#39', DATE_FORMAT(e.fecha,  '#39 +
        '%d/%m/%Y'#39'), '#39' - '#39', e.nombre) as nombre '
      'from evento e'
      'order by e.nro_fecha')
    Params = <>
    Left = 64
    Top = 392
  end
  object DSEvento: TDataSource
    DataSet = ZEvento
    Left = 96
    Top = 392
  end
