  object ZROQPilotosParadaEvento: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        'select pil.nro_moto '#39'Nro. Moto'#39', concat(pil.apellido, '#39', '#39', pil.' +
        'nombre) '#39'Piloto'#39', DATE_FORMAT(pp.fecha_ingreso, '#39'%H:%i:%s'#39') '#39'Tie' +
        'mpo Ingreso'#39
      'from paradas_piloto pp'
      '     join piloto pil on pp.piloto_oid = pil.oid'
      'where pp.evento_oid = :evento_oid     '
      'order by pp.fecha_ingreso')
    Params = <
      item
        DataType = ftInteger
        Name = 'evento_oid'
        ParamType = ptInput
        Value = '1'
      end>
    Left = 512
    Top = 208
    ParamData = <
      item
        DataType = ftInteger
        Name = 'evento_oid'
        ParamType = ptInput
        Value = '1'
      end>
  end
