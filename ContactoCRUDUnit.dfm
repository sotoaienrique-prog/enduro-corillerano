  inherited queryGrid: TZReadOnlyQuery
    SQL.Strings = (
      'SELECT'
      
        '  u.oid, u.nombre, apellido, direccion, u.localidad_oid, telefon' +
        'o_fijo, telefono_celular, email, l.localidad as nombre_localidad' +
        ', '
      '  p.provincia as nombre_provincia'
      'FROM contacto u'
      '     LEFT JOIN localidad l on u.localidad_oid = l.oid  '
      '     JOIN provincias p on l.provincia_oid = p.oid  '
      
        'where (:nombre is null or LENGTH(:nombre) = 0 or u.nombre LIKE C' +
        'ONCAT('#39'%'#39', :nombre, '#39'%'#39')) and'
      
        '      (:apellido is null or LENGTH(:apellido) = 0 or u.apellido ' +
        'LIKE CONCAT('#39'%'#39', :apellido, '#39'%'#39'))')
    Params = <
      item
        DataType = ftUnknown
        Name = 'nombre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'apellido'
        ParamType = ptUnknown
      end>
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'nombre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'apellido'
        ParamType = ptUnknown
      end>
  end
