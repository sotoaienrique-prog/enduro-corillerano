  object ZExportarContacto: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      'SELECT'
      
        '  u.nombre Nombre, apellido Apellido, direccion '#39'Direcci'#243'n'#39', tel' +
        'efono_fijo '#39'Tel'#233'fono Fijo'#39', telefono_celular '#39'Tel'#233'fono Celular'#39',' +
        ' email '#39'Mail'#39','
      '  l.localidad as Localidad, p.provincia as Provincia'
      'FROM contacto u'
      '     LEFT JOIN localidad l on u.localidad_oid = l.oid  '
      '     JOIN provincias p on l.provincia_oid = p.oid')
    Params = <>
    Left = 40
    Top = 304
  end
end
