  object ZRecargo: TZQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        'select rtte.oid, tte.nombre as toma_tiempo_evento, tr.nombre as ' +
        'tipo_recargo, '
      
        'CONCAT(p.apellido, '#39', '#39' , p.nombre) as piloto, rtte.segundos_rec' +
        'argo,'
      
        'sel_nro_moto_by_evento_and_tipo_categoria(rtte.tipo_categoria_oi' +
        'd, tte.evento_oid, p.oid) nro_moto'
      'from recargo_toma_tiempo_evento rtte'
      
        '     inner join toma_tiempo_evento tte on rtte.toma_tiempo_event' +
        'o_oid = tte.oid'
      '     inner join piloto p on rtte.piloto_oid = p.oid'
      '     inner join tipo_recargo tr on rtte.tipo_recargo = tr.oid'
      'WHERE'
      
        '      (:evento_oid is null or :evento_oid = 0 or tte.evento_oid=' +
        ' :evento_oid)')
    Params = <
      item
        DataType = ftUnknown
        Name = 'evento_oid'
        ParamType = ptUnknown
      end>
    Left = 96
    Top = 432
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'evento_oid'
        ParamType = ptUnknown
      end>
  end
