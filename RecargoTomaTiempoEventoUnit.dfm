  object ZFilterEvento: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        'select e.oid, CONCAT(e.nro_fecha, '#39' - '#39', DATE_FORMAT(e.fecha,  '#39 +
        '%d/%m/%Y'#39'), '#39' - '#39', e.nombre) as nombre , e.campeonato_oid '
      'from evento e'
      'order by e.nro_fecha')
    Params = <>
    MasterFields = 'oid'
    MasterSource = DSCampeonatoFilter
    LinkedFields = 'campeonato_oid'
    Left = 80
    Top = 184
  end
  object DSFilterEvento: TDataSource
    DataSet = ZFilterEvento
    Left = 80
    Top = 232
  end
  object ZRecargoDisplay: TZQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        'select tte.nombre as '#39'Toma Tiempo Evento'#39', tr.nombre as '#39'Tipo Re' +
        'cargo'#39', '
      
        'CONCAT(p.apellido, '#39', '#39' , p.nombre) as Piloto, rtte.segundos_rec' +
        'argo as '#39'Segundos Recargo'#39','
      
        'sel_nro_moto_by_evento_and_tipo_categoria(rtte.tipo_categoria_oi' +
        'd, tte.evento_oid, p.oid) as '#39'Nro. Moto'#39
      'from recargo_toma_tiempo_evento rtte'
      
        '     inner join toma_tiempo_evento tte on rtte.toma_tiempo_event' +
        'o_oid = tte.oid'
      '     inner join piloto p on rtte.piloto_oid = p.oid'
      '     inner join tipo_recargo tr on rtte.tipo_recargo = tr.oid'
      '     inner join evento e on e.oid = tte.evento_oid'
      'WHERE'
      
        '      (:campeonato_oid is null or :campeonato_oid = 0 or e.campe' +
        'onato_oid= :campeonato_oid)')
    Params = <
      item
        DataType = ftUnknown
        Name = 'campeonato_oid'
        ParamType = ptUnknown
      end>
    Left = 176
    Top = 432
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'campeonato_oid'
        ParamType = ptUnknown
      end>
  end
