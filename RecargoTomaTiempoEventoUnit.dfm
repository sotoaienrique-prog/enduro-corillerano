  object ZTomaTiempoEvento: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        'select oid, CONCAT(date_format(toma_tiempo_start_time, '#39'%d/%m/%Y' +
        ' %H:%i:%s'#39'), '#39' - '#39', nombre) as nombre, evento_oid'
      'from toma_tiempo_evento'
      
        'where (:evento_oid is null or :evento_oid = 0 or evento_oid= :ev' +
        'ento_oid)'
      '  and tipo_toma_tiempo = :tipo_toma_tiempo'
      'order by oid desc')
    Params = <
      item
        DataType = ftUnknown
        Name = 'evento_oid'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipo_toma_tiempo'
        ParamType = ptUnknown
      end>
    MasterFields = 'oid'
    LinkedFields = 'evento_oid'
    Left = 184
    Top = 272
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'evento_oid'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipo_toma_tiempo'
        ParamType = ptUnknown
      end>
  end
