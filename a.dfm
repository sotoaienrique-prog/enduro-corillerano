  inherited queryGrid: TZReadOnlyQuery
    SQL.Strings = (
      
        'select ipe.oid, p.oid as piloto_oid, sel_nro_moto_by_evento_and_' +
        'tipo_categoria(ipe.tipo_categoria_oid, ipe.evento_oid, p.oid) as' +
        ' nro_moto, '
      
        'CONCAT(e.nro_fecha, '#39' - '#39', DATE_FORMAT(e.fecha,  '#39'%d/%m/%Y'#39'), '#39' ' +
        '- '#39', e.nombre) nombre_evento, '
      'CONCAT(p.apellido, '#39', '#39' , p.nombre) as nombre_pilot, '
      
        '       CASE WHEN cat.utiliza_acompaniante = 1 THEN CONCAT(UC_Wor' +
        'ds(CONCAT(p.apellido, '#39', '#39' , p.nombre)), IFNULL(UC_Words(CONCAT(' +
        #39' / '#39', n.apellido, '#39', '#39' , n.nombre)), '#39#39')) '
      '            ELSE UC_Words(CONCAT(p.apellido, '#39', '#39' , p.nombre))'
      '       end as nombre_piloto,'
      'c.nombre nombre_campeonato, '
      
        'sel_nombre_categoria_by_evento_and_tipo_categoria(ipe.tipo_categ' +
        'oria_oid, ipe.evento_oid, p.oid) as nombre_categoria, tc.nombre ' +
        'tipo_categoria, ipe.tipo_categoria_oid, ipe.evento_oid'
      'FROM inscripcion_piloto_evento ipe'
      '     JOIN piloto p on ipe.piloto_oid = p.oid'
      '     JOIN evento e on ipe.evento_oid = e.oid'
      '     JOIN campeonato c on e.campeonato_oid = c.oid'
      '     JOIN tipo_categoria tc on ipe.tipo_categoria_oid = tc.oid'
      
        '     left join navegante n on n.piloto_oid = p.oid, categorias c' +
        'at'
      'WHERE'
      
        '      (:evento_oid is null or :evento_oid = 0 or ipe.evento_oid=' +
        ' :evento_oid) AND'
      
        '      (:piloto_oid is null or :piloto_oid = 0 or  ipe.piloto_oid' +
        '= :piloto_oid) AND'
      '      (:categoria_oid is null or :categoria_oid = 0 or'
      ' CASE ipe.tipo_categoria_oid'
      '          WHEN  1 THEN p.categoria_oid'
      '          WHEN  2 THEN p.categoria_cuatriciclos_oid'
      
        '          WHEN  3 THEN p.categoria_motocross_oid                ' +
        '                '
      '     END = :categoria_oid)'
      
        '   and cat.oid = sel_categoria_oid_by_evento_and_tipo_categoria(' +
        'ipe.tipo_categoria_oid, ipe.evento_oid, ipe.piloto_oid)'
      'LIMIT 500')
    Params = <
      item
        DataType = ftInteger
        Name = 'evento_oid'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'piloto_oid'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'categoria_oid'
        ParamType = ptInput
      end>
    Left = 504
    Top = 272
    ParamData = <
      item
        DataType = ftInteger
        Name = 'evento_oid'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'piloto_oid'
        ParamType = ptInput
      end
      item
        DataType = ftInteger
        Name = 'categoria_oid'
        ParamType = ptInput
      end>
  end
  inherited dataSourceGrid: TDataSource
    Left = 592
    Top = 304
  end
