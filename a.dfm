  object ZExportarValores: TZQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      'select cat.nombre as '#39'Categor'#237'a'#39','
      '       COUNT(ipe.evento_oid) Inscriptos,'
      
        '       (COUNT(ipe.evento_oid) - (sel_piloto_oid_campeon_by_event' +
        'o_and_tipo_cat(ipe.tipo_categoria_oid, ipe.piloto_oid, ipe.event' +
        'o_oid) > 0)) * cat.valor_organizador as '#39'Valor Organizador'#39','
      
        '       (COUNT(ipe.evento_oid) - (sel_piloto_oid_campeon_by_event' +
        'o_and_tipo_cat(ipe.tipo_categoria_oid, ipe.piloto_oid, ipe.event' +
        'o_oid) > 0)) * cat.valor_cordillerano as '#39'Valor Cordillerano'#39','
      '       (SELECT CONCAT(pil.apellido, '#39', '#39', pil.nombre) pilo '
      '               from piloto pil '
      
        '               where pil.oid = sel_piloto_oid_campeon_by_evento_' +
        'and_tipo_cat(ipe.tipo_categoria_oid, ipe.piloto_oid, ipe.evento_' +
        'oid)) '#39'Campe'#243'n'#39
      'from inscripcion_piloto_evento ipe'
      '     join piloto p on ipe.piloto_oid = p.oid'
      '     join evento e on ipe.evento_oid = e.oid,'
      '     categorias cat'
      'where ipe.evento_oid = :evento_oid'
      
        '   and cat.oid = sel_categoria_oid_by_evento_and_tipo_categoria(' +
        'ipe.tipo_categoria_oid, ipe.evento_oid, p.oid) '
      'group by cat.nombre'
      'order by cat.tipo_categoria_oid, '#39'Categor'#237'a'#39)
    Params = <
      item
        DataType = ftInteger
        Name = 'evento_oid'
        ParamType = ptInput
      end>
    Properties.Strings = (
      'codepage=utf8')
    Left = 248
    Top = 408
    ParamData = <
      item
        DataType = ftInteger
        Name = 'evento_oid'
        ParamType = ptInput
      end>
  end
  object ZInscripcionesPorPiloto: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      'select count(ipe.oid) as inscripciones'
      'from inscripcion_piloto_evento ipe'
      '     inner join evento e on ipe.evento_oid = e.oid'
      'where ipe.piloto_oid = :piloto_oid'
      '      and e.campeonato_oid = :campeonato_oid'
      'having inscripciones = (select count(e.oid) - 1'
      '                          from evento e'
      
        '                          where e.campeonato_oid = :campeonato_o' +
        'id);')
    Params = <
      item
        DataType = ftUnknown
        Name = 'piloto_oid'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'campeonato_oid'
        ParamType = ptUnknown
      end>
    Left = 32
    Top = 416
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'piloto_oid'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'campeonato_oid'
        ParamType = ptUnknown
      end>
  end
  object ZInscripcionMasiva: TZQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        'insert into inscripcion_piloto_evento(evento_oid, piloto_oid, es' +
        '_dia_inscripcion, tipo_categoria_oid)'
      'select :evento_oid, p.oid, 1, 1  '
      'from piloto p'
      
        'where not exists(select oid from inscripcion_piloto_evento ipe w' +
        'here ipe.evento_oid = :evento_oid)'
      '      and p.nro_moto is not null'
      '      ')
    Params = <
      item
        DataType = ftUnknown
        Name = 'evento_oid'
        ParamType = ptUnknown
      end>
    Left = 624
    Top = 16
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'evento_oid'
        ParamType = ptUnknown
      end>
  end
  object ZExportarDatosInscriptosT: TZQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      'select 1 as '#39'Nro.'#39','
      
        'CONCAT(p.apellido, '#39', '#39' , p.nombre) as '#39'Apellido y Nombre/s'#39', p.' +
        'nro_docu '#39'DNI'#39', '
      'prov.provincia as '#39'Provincia'#39','
      'l.localidad Localidad, p.direccion '#39'Direcci'#243'n (Calle, nro)'#39', '
      'p.email '#39'e-Correo'#39', '
      #39#39' as '#39'N'#176' Recibo'#39','
      
        'CONCAT('#39' '#39', p.telefono) '#39'Tel'#233'fono'#39', p.telefono_acompaniante '#39'Tel' +
        #233'fono Acompa'#241'ante'#39', '
      'p.notas as '#39'SINIESTRO-Descripci'#243'n-Seguimiento:'#39
      ''
      'from inscripcion_piloto_evento ipe'
      '     join piloto p on ipe.piloto_oid = p.oid'
      '     left join localidad l on p.localidad_oid = l.oid'
      '     left join provincias prov on prov.oid = l.provincia_oid'
      
        '     left join modelo_moto mm on p.modelo_moto_oid = mm.oid     ' +
        '     '
      '     join evento e on ipe.evento_oid = e.oid, categorias cat'
      'where ipe.evento_oid = :evento_oid'
      
        '    and cat.oid = sel_categoria_oid_by_evento_and_tipo_categoria' +
        '(ipe.tipo_categoria_oid, :evento_oid, ipe.piloto_oid)'
      'order by ipe.oid, p.apellido, p.nombre, '#39'Categor'#237'a'#39)
    Params = <
      item
        DataType = ftUnknown
        Name = 'evento_oid'
        ParamType = ptUnknown
      end>
    Properties.Strings = (
      'codepage=utf8')
    Left = 248
    Top = 456
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'evento_oid'
        ParamType = ptUnknown
      end>
  end
