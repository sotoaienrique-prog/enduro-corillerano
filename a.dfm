  object ZExportarDatosInscriptos: TZQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        'select CONCAT(p.apellido, '#39', '#39' , p.nombre) as Piloto, l.localida' +
        'd Localidad, p.direccion '#39'Direcci'#243'n'#39', '
      'p.fecha_nacimiento '#39'Fecha Nacimiento'#39', p.nro_docu '#39'Documento'#39', '
      
        'CONCAT('#39' '#39', p.telefono) '#39'Tel'#233'fono'#39', p.telefono_acompaniante '#39'Tel' +
        #233'fono Acompa'#241'ante'#39', p.email Mail, '
      
        'sel_nro_moto_by_evento_and_tipo_categoria(ipe.tipo_categoria_oid' +
        ', ipe.evento_oid, p.oid) as '#39'Nro. Moto'#39', mm.nombre as Moto, '
      
        'sel_nombre_categoria_by_evento_and_tipo_categoria(ipe.tipo_categ' +
        'oria_oid, ipe.evento_oid, p.oid) as '#39'Categor'#237'a'#39', CONCAT('#39'$ '#39', ca' +
        't.valor_seguro) as '#39'Valor Seguro'#39
      ''
      'from inscripcion_piloto_evento ipe'
      '     join piloto p on ipe.piloto_oid = p.oid'
      '     left join localidad l on p.localidad_oid = l.oid'
      
        '     left join modelo_moto mm on p.modelo_moto_oid = mm.oid     ' +
        '     '
      '     join evento e on ipe.evento_oid = e.oid,'
      '     categorias cat'
      'where ipe.evento_oid = :evento_oid'
      
        '   and cat.oid = sel_categoria_oid_by_evento_and_tipo_categoria(' +
        'ipe.tipo_categoria_oid, ipe.evento_oid, p.oid) '
      'order by ipe.oid, p.apellido, p.nombre, '#39'Categor'#237'a'#39)
    Params = <
      item
        DataType = ftInteger
        Name = 'evento_oid'
        ParamType = ptInput
      end>
    Properties.Strings = (
      'codepage=utf8')
    Left = 144
    Top = 456
    ParamData = <
      item
        DataType = ftInteger
        Name = 'evento_oid'
        ParamType = ptInput
      end>
  end
