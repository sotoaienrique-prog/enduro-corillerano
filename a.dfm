  object ZSelectedPilotData: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      'select p.*, '
      
        'CONCAT(sel_nro_moto_by_evento_and_tipo_categoria(:tipo_categoria' +
        '_oid, :evento_oid, p.oid)+'#39#39', '#39' - '#39', p.apellido, '#39', '#39' , p.nombre' +
        ') as piloto, '
      
        '       CASE WHEN c.utiliza_acompaniante = 1 THEN CONCAT(UC_Words' +
        '(CONCAT(sel_nro_moto_by_evento_and_tipo_categoria(:tipo_categori' +
        'a_oid, :evento_oid, p.oid)+'#39#39', '#39' - '#39', p.apellido, '#39', '#39' , p.nombr' +
        'e)), IFNULL(UC_Words(CONCAT('#39' / '#39', n.apellido, '#39', '#39' , n.nombre))' +
        ', '#39#39')) '
      
        '            ELSE UC_Words(CONCAT(sel_nro_moto_by_evento_and_tipo' +
        '_categoria(:tipo_categoria_oid, :evento_oid, p.oid)+'#39#39', '#39' - '#39', p' +
        '.apellido, '#39', '#39' , p.nombre)) end  as nombre_piloto, '
      '       c.nombre nombre_categoria, mm.nombre as modelo_moto,'
      
        '  l.localidad as nombre_localidad, prov.provincia as nombre_prov' +
        'incia,'
      
        '  DAYOFMONTH(CURDATE()) dia, MONTH(CURDATE()) mes,YEAR(CURDATE()' +
        ') anio, '
      
        '  c.valor_seguro, CONCAT(c.valor_seguro_texto, '#39'.-'#39') AS valor_se' +
        'guro_texto'
      'from piloto p'
      
        '     LEFT join categorias c on c.oid = sel_categoria_oid_by_even' +
        'to_and_tipo_categoria(:tipo_categoria_oid, :evento_oid, p.oid) '
      '     LEFT join modelo_moto mm on p.modelo_moto_oid = mm.oid'
      '     LEFT JOIN localidad l on p.localidad_oid = l.oid  '
      '     LEFT JOIN provincias prov on l.provincia_oid = prov.oid  '
      '     left join navegante n on n.piloto_oid = p.oid'
      'where p.oid =:oid')
    Params = <
      item
        DataType = ftUnknown
        Name = 'tipo_categoria_oid'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'evento_oid'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'oid'
        ParamType = ptUnknown
      end>
    DataSource = dataSourceGrid
    Left = 920
    Top = 8
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'tipo_categoria_oid'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'evento_oid'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'oid'
        ParamType = ptUnknown
      end>
  end
  object ZFilterPiloto: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        'select p.oid, CONCAT(TRIM(p.apellido), '#39', '#39' ,TRIM( p.nombre)) as' +
        ' nombre'
      'from piloto p'
      'order by TRIM(p.apellido), TRIM(p.nombre)')
    Params = <>
    Left = 2
    Top = 128
  end
  object ZExportarInscripcion: TZQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        'select sel_nro_moto_by_evento_and_tipo_categoria(ipe.tipo_catego' +
        'ria_oid, ipe.evento_oid, p.oid) as '#39'Nro. Moto'#39', '
      
        ' p.nombre Nombre, p.apellido Apellido, l.localidad Localidad, mm' +
        '.nombre as Moto, '
      
        ' sel_nombre_categoria_by_evento_and_tipo_categoria(ipe.tipo_cate' +
        'goria_oid, ipe.evento_oid, p.oid) as '#39'Categor'#237'a'#39', '
      
        ' sel_handicup_by_evento_and_piloto_and_tipo_categoria(ipe.tipo_c' +
        'ategoria_oid, ipe.evento_oid, ipe.piloto_oid) as Handicup,'
      
        ' sel_total_puntos_by_event_oid_and_pilot_oid(ipe.evento_oid, ipe' +
        '.piloto_oid, e.campeonato_oid, ipe.tipo_categoria_oid, sel_categ' +
        'oria_oid_by_evento_and_tipo_categoria(ipe.tipo_categoria_oid, ip' +
        'e.evento_oid, p.oid))  as Puntos,'
      
        ' sel_puesto_by_event_oid_and_pilot_oid(select_evento_previo_by_e' +
        'vento_oid(ipe.evento_oid), ipe.piloto_oid, ipe.tipo_categoria_oi' +
        'd, sel_categoria_oid_by_evento_and_tipo_categoria(ipe.tipo_categ' +
        'oria_oid, ipe.evento_oid, p.oid)) as '#39'Puesto Evento Anterior'#39','
      
        ' ipe.oid as '#39'Nro. Orden Inscripci'#243'n'#39', CONCAT('#39'$ '#39', cat.valor_seg' +
        'uro) as '#39'Valor Seguro'#39
      'from inscripcion_piloto_evento ipe'
      '     join piloto p on ipe.piloto_oid = p.oid'
      '     left join localidad l on p.localidad_oid = l.oid'
      
        '     left join modelo_moto mm on p.modelo_moto_oid = mm.oid     ' +
        '     '
      '     join evento e on ipe.evento_oid = e.oid,'
      '     categorias cat'
      'where ipe.evento_oid = :evento_oid'
      
        '   and cat.oid = sel_categoria_oid_by_evento_and_tipo_categoria(' +
        'ipe.tipo_categoria_oid, ipe.evento_oid, p.oid) '
      
        'order by sel_nombre_categoria_by_evento_and_tipo_categoria(ipe.t' +
        'ipo_categoria_oid, ipe.evento_oid, p.oid), '
      'ipe.es_dia_inscripcion desc, '
      'Puntos desc,'
      #39'Puesto Evento Anterior'#39', '
      'ipe.oid'
      '         ')
    Params = <
      item
        DataType = ftInteger
        Name = 'evento_oid'
        ParamType = ptInput
      end>
    Properties.Strings = (
      'codepage=utf8')
    Left = 144
    Top = 408
    ParamData = <
      item
        DataType = ftInteger
        Name = 'evento_oid'
        ParamType = ptInput
      end>
  end
  object ZFilterEvento: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        'select e.oid, CONCAT(e.nro_fecha, '#39' - '#39', DATE_FORMAT(e.fecha,  '#39 +
        '%d/%m/%Y'#39'), '#39' - '#39', e.nombre) as nombre , e.campeonato_oid '
      'from evento e'
      'order by e.nro_fecha desc')
    Params = <>
    MasterFields = 'oid'
    MasterSource = DSCampeonatoFilter
    LinkedFields = 'campeonato_oid'
    Left = 74
    Top = 128
  end
  object ZEvento: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        'select e.oid, CONCAT(e.nro_fecha, '#39' - '#39', DATE_FORMAT(e.fecha,  '#39 +
        '%d/%m/%Y'#39'), '#39' - '#39', e.nombre) as nombre, e.campeonato_oid'
      'from evento e'
      'order by e.nro_fecha')
    Params = <>
    MasterFields = 'oid'
    MasterSource = DSCampeonato
    LinkedFields = 'campeonato_oid'
    Left = 352
    Top = 344
  end
