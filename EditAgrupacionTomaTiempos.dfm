  object zExportarAgrupacion: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        'SELECT 0 as Posicion, nro_competidor '#39'Nro. Competidor'#39', nombre_p' +
        'iloto Competidor, Categoria, '
      
        'CONCAT(sel_formatted_total_time(SUM(tiempo_total)), '#39'.'#39') '#39'Tiempo' +
        ' Total'#39', SUM(ranking.Vueltas) Vueltas,'
      
        '       '#39#39' as DescripcionRecargo, 0 as Recargo, 0 as TOT_1, 0 as ' +
        'TOT_2, 0 as TOT_3,'
      '                0 as TOT_4, 0 as TOT_5, 0 as TOT_6'
      
        'from (select tte.oid, sel_nro_moto_by_evento_and_tipo_categoria(' +
        'ipe.tipo_categoria_oid, tte.evento_oid, ipe.piloto_oid) nro_comp' +
        'etidor,'
      '       CONCAT(p.apellido, '#39', '#39', p.nombre) as nombre_piloto, '
      
        '       sel_nombre_categoria_by_evento_and_tipo_categoria(ipe.tip' +
        'o_categoria_oid, tte.evento_oid, ipe.piloto_oid) Categoria, '
      
        '       sel_categoria_oid_by_evento_and_tipo_categoria(ipe.tipo_c' +
        'ategoria_oid, tte.evento_oid, ipe.piloto_oid) categoria_oid,'
      
        '       sel_total_time_recono(tt.toma_tiempo_evento_oid, tt.pilot' +
        'o_oid) tiempo_total,'
      
        '       sel_can_vueltas_recono(tt.toma_tiempo_evento_oid, tt.pilo' +
        'to_oid) Vueltas'
      'from toma_tiempos_reconocimiento tt '
      
        '     join toma_tiempo_evento tte on tt.toma_tiempo_evento_oid = ' +
        'tte.oid '
      '     join piloto p on tt.piloto_oid = p.oid '
      '     join inscripcion_piloto_evento ipe on '
      
        '           (ipe.evento_oid = tte.evento_oid and ipe.piloto_oid =' +
        ' tt.piloto_oid) '
      
        '     where tte.oid in (SELECT DISTINCT toma_tiempo_oid FROM toma' +
        '_tiempo_agrupacion_tt WHERE toma_tiempo_agrupacion_oid = :toma_t' +
        'iempo_agrupacion_oid)'
      
        '     group by p.oid, tte.oid) ranking inner join categorias c on' +
        ' c.oid = categoria_oid'
      'group by nro_competidor, nombre_piloto, Categoria'
      
        'order by c.orden IS NULL, c.orden, Vueltas desc, '#39'Tiempo Total'#39' ' +
        'asc  ')
    Params = <
      item
        DataType = ftUnknown
        Name = 'toma_tiempo_agrupacion_oid'
        ParamType = ptUnknown
      end>
    Left = 80
    Top = 288
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'toma_tiempo_agrupacion_oid'
        ParamType = ptUnknown
      end>
  end
  object ZTomaTiemposForExport: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      'select tte.oid, tte.nombre as nombre'
      'from toma_tiempo_agrupacion_tt tta'
      
        '     inner join toma_tiempo_evento tte on tta.toma_tiempo_oid = ' +
        'tte.oid '
      
        'where tta.toma_tiempo_agrupacion_oid = :toma_tiempo_agrupacion_o' +
        'id')
    Params = <
      item
        DataType = ftUnknown
