  object DSEvento: TDataSource
    DataSet = ZEvento
    Left = 176
    Top = 216
  end
  object ZTomaTiempoEvento: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        'select oid, CONCAT(date_format(toma_tiempo_start_time, '#39'%d/%m/%Y' +
        ' %H:%i:%s'#39'), '#39' - '#39', nombre) as nombre, evento_oid,'
      'nombre as nombre_st'
      'from toma_tiempo_evento'
      'where tipo_toma_tiempo = :tipo_toma_tiempo'
      'order by oid desc')
    Params = <
      item
        DataType = ftUnknown
        Name = 'tipo_toma_tiempo'
        ParamType = ptUnknown
      end>
    MasterFields = 'oid'
    MasterSource = DSEvento
    LinkedFields = 'evento_oid'
    Left = 256
    Top = 168
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'tipo_toma_tiempo'
        ParamType = ptUnknown
      end>
  end
  object DSTomaTiempoEvento: TDataSource
    DataSet = ZTomaTiempoEvento
    Left = 256
    Top = 216
  end
  object ZEvento: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        'select e.oid, CONCAT(e.nro_fecha, '#39' - '#39', DATE_FORMAT(e.fecha,  '#39 +
        '%d/%m/%Y'#39'), '#39' - '#39', e.nombre) as nombre, e.campeonato_oid,'
      'CONCAT(e.nro_fecha, '#39' - '#39', e.nombre) as nombre_st'
      'from evento e'
      'order by e.nro_fecha')
    Params = <>
    MasterFields = 'oid'
    MasterSource = DSCampeonato
    LinkedFields = 'campeonato_oid'
    Left = 176
    Top = 168
  end
  object ZTomaTiempos: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        'select tte.oid, CONCAT(date_format(tte.toma_tiempo_start_time, '#39 +
        '%d/%m/%Y %H:%i:%s'#39'), '#39' - '#39', tte.nombre) as nombre,'
      'nombre as nombre_st,'
      ' evento_oid'
      'from toma_tiempo_agrupacion_tt tta'
      
        '     inner join toma_tiempo_evento tte on tta.toma_tiempo_oid = ' +
        'tte.oid '
      
        'where tta.toma_tiempo_agrupacion_oid = :toma_tiempo_agrupacion_o' +
        'id')
    Params = <
      item
        DataType = ftUnknown
        Name = 'toma_tiempo_agrupacion_oid'
        ParamType = ptUnknown
      end>
    Left = 256
    Top = 360
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'toma_tiempo_agrupacion_oid'
        ParamType = ptUnknown
      end>
    object ZTomaTiemposnombre: TWideStringField
      FieldName = 'nombre'
      Size = 765
    end
    object ZTomaTiemposoid: TLargeintField
      FieldName = 'oid'
      Required = True
    end
  end
  object DSTomaTiempos: TDataSource
    DataSet = ZTomaTiempos
    Left = 256
    Top = 312
  end
  object ZAgrupacion: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      'SELECT'
      '  oid, nombre, tipo_agrupacion, tipo_toma_tiempo'
      'FROM toma_tiempo_agrupacion'
      'where oid = :oid')
    Params = <
      item
        DataType = ftUnknown
        Name = 'oid'
        ParamType = ptUnknown
      end>
    Left = 160
    Top = 360
    ParamData = <
      item
        DataType = ftUnknown
