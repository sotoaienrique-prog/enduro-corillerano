  object ZQueryInsert: TZQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      'INSERT INTO toma_tiempo_agrupacion'
      '    (nombre, tipo_agrupacion, tipo_toma_tiempo)'
      'VALUES'
      '    (:nombre, :tipo_agrupacion, :tipo_toma_tiempo)')
    Params = <
      item
        DataType = ftUnknown
        Name = 'nombre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipo_agrupacion'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipo_toma_tiempo'
        ParamType = ptUnknown
      end>
    Left = 352
    Top = 216
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'nombre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipo_agrupacion'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipo_toma_tiempo'
        ParamType = ptUnknown
      end>
  end
