  inherited queryGrid: TZReadOnlyQuery
    SQL.Strings = (
      'select mm.oid, mm.nombre, mm.puntos_extra'
      'from modelo_moto mm'
      
        'where (:nombre is null or LENGTH(:nombre) = 0 or mm.nombre like ' +
        ' CONCAT('#39'%'#39',:nombre,'#39'%'#39'))')
    Params = <
      item
        DataType = ftString
        Name = 'nombre'
        ParamType = ptInput
      end>
    ParamData = <
      item
        DataType = ftString
        Name = 'nombre'
        ParamType = ptInput
      end>
  end
  inherited cxFilterImageList: TcxImageList
    FormatVersion = 1
  end
