  object ZAgrupacion: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      'select oid, nombre, tipo_agrupacion, tipo_toma_tiempo'
      'from toma_tiempo_agrupacion'
      
        'where (:nombre is null or LENGTH(:nombre) = 0 or nombre like  CO' +
        'NCAT('#39'%'#39',:nombre,'#39'%'#39'))')
