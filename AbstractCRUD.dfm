  object alMain: TActionList
    Images = ilMain
    Left = 136
    Top = 192
    object actFiltering: TAction
      Category = 'GridOptions'
      Caption = 'Mostrar Filtrado'
      Hint = 'Muestra la secci'#243'n para definir Filtros'
      ImageIndex = 53
      OnExecute = actFilteringExecute
    end
    object actShowDescription: TAction
      Category = 'View'
      Caption = 'Show &Description'
      Checked = True
      Hint = 
        'Press to display/hide the description panel with the currently d' +
        'isplayed information'
    end
    object actColumnsCustomize: TAction
      Category = 'Actions'
      Caption = 'RunTime &Column Customization'
      Hint = 'Presione para personalizar las columnas'
      ImageIndex = 24
      OnExecute = actColumnsCustomizeExecute
    end
    object actExit: TAction
      Category = 'File'
      Caption = 'E&xit'
      Hint = 'Presione para cerrar la visualizaci'#243'n'
      ImageIndex = 54
      ShortCut = 27
    end
    object actShowPictures: TAction
      Category = 'View'
      Caption = 'Show &Pictures In A Grid'
      Hint = 
        'Press to activate/deactivate the display of images within grid c' +
        'ells'
    end
    object actGrouping: TAction
      Category = 'GridOptions'
      Caption = 'Mostrar &GroupBox'
      Checked = True
      Hint = 
        'Despliega el grupo de paneles que contiene los encabezados de co' +
        'lumna usados para agrupar'
      ImageIndex = 5
      OnExecute = actGroupingExecute
    end
    object acIndicator: TAction
      Category = 'GridOptions'
      Caption = 'Mostrar &Indicador'
      Hint = 
        'Despliega el indicador en la grilla especificando el estado del ' +
        'registro'
      ImageIndex = 6
      OnExecute = acIndicatorExecute
    end
    object actSummaryFooter: TAction
      Category = 'GridOptions'
      Caption = 'Mostrar Sumario al pie'
      Hint = 'Despliega el sumario al pie de la grilla'
      ImageIndex = 7
    end
    object actHeader: TAction
      Category = 'GridOptions'
      Caption = 'Mostrar &Encabezado'
      Hint = 'Muestra el encabezado para todas las columnas de la grilla'
      ImageIndex = 8
      OnExecute = actHeaderExecute
    end
    object actAutoWidth: TAction
      Category = 'GridOptions'
      Caption = 'Autoajuste de &Columnas'
      Checked = True
      Hint = 
        'Automaticamente ajusta el ancho de las columnas al tama'#241'o de la ' +
        'grilla'
      ImageIndex = 19
      OnExecute = actAutoWidthExecute
    end
    object actInvertSelected: TAction
      Category = 'GridOptions'
      Caption = 'In&vertir Selecci'#243'n'
      Checked = True
      Hint = 
        'Muestra el indicador de la grilla especificando el estado del re' +
        'gistro'
      ImageIndex = 23
      OnExecute = actInvertSelectedExecute
    end
    object actFullExpand: TAction
      Category = 'Actions'
      Caption = 'Full &Expand'
      Hint = 'Presione para expandir todo los registros'
      ImageIndex = 27
      OnExecute = actFullExpandExecute
    end
    object actFullCollapse: TAction
      Category = 'Actions'
      Caption = 'Full &Collapse'
      Hint = 'Presione para colapsar todos los registros'
      ImageIndex = 26
      OnExecute = actFullCollapseExecute
    end
    object actBestFit: TAction
      Category = 'Actions'
      Caption = 'Best Fit (all columns)'
      Hint = 
        'Cambia el ancho de las columnas al mejor ajuste dentro de la gri' +
        'lla'
      OnExecute = actBestFitExecute
    end
    object actShowEditButtons: TAction
      Category = 'GridOptions'
      Caption = 'Show Edit &Buttons'
      Hint = 
        'Muestra/oculta los botones de edici'#243'n para el registro seleccion' +
        'ado'
      ImageIndex = 22
    end
    object actAbout: TAction
      Category = 'Help'
      Caption = '&About...'
    end
    object actGridLines: TAction
      Category = 'GridOptions'
      Caption = 'Show Grid &Lines'
      Checked = True
      Hint = 'Muestra/oculta las l'#237'neas horizontales y verticales de la grilla'
      ImageIndex = 20
      OnExecute = actGridLinesExecute
    end
    object actAutoPreview: TAction
      Category = 'GridOptions'
      Caption = 'Auto&Preview'
      Checked = True
      Hint = 'Display the preview section for each row '
      ImageIndex = 21
      OnExecute = actAutoPreviewExecute
    end
    object actShowDependsOnData: TAction
      Category = 'View'
      Caption = 'Depends On Data'
      Checked = True
      Hint = 'Press to activate/deactivate drawing depending on data'
    end
    object actNewItemRow: TAction
      Category = 'GridOptions'
      Caption = 'Show New Item Row'
      Hint = 'Press to display an empty row to enter new values'
    end
    object actSelectStyleSheet: TAction
      Category = 'GridOptions'
      Caption = 'Select Predefined StyleSheet...'
    end
    object actEditorsShadow: TAction
      Category = 'Style'
      Caption = '&Editors Shadow'
      Checked = True
      Hint = 
        'Setting this option activates/deactivates the shadow for stand-a' +
        'lone editors'
    end
    object actPageSetup: TAction
      Caption = '&Configuraci'#243'n de P'#225'gina'
      ImageIndex = 50
    end
    object actPreview: TAction
      Caption = 'Previsualizaci'#243'n de Impresi'#243'n'
      ImageIndex = 48
    end
    object acPrint: TAction
      Caption = '&Imprimir'
      ImageIndex = 18
    end
    object actDesigner: TAction
      Caption = '&Dise'#241'o de Impresi'#243'n'
      ImageIndex = 51
    end
    object acExportExel: TAction
      Caption = 'Exportar a Excel'
      ImageIndex = 52
    end
  end
end
