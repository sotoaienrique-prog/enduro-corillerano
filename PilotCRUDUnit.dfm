  object ZExportarPilotos: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      'SELECT'
      
        '   CONCAT(UPPER(LEFT(u.nombre, 1)), LOWER(SUBSTRING(u.nombre, 2)' +
        ')) AS Nombre,'
      
        '  CONCAT(UPPER(LEFT(u.apellido, 1)), LOWER(SUBSTRING(u.apellido,' +
        ' 2))) AS Apellido,'
      '  TIMESTAMPDIFF(YEAR, u.fecha_nacimiento, CURDATE()) AS Edad,'
      '  u.nro_docu '#39'Nro. Documento'#39', '
      '  u.fecha_nacimiento '#39'Fecha Nacimiento'#39', '
      '  u.direccion '#39'Direcci'#243'n'#39', '
      '  u.telefono '#39'Tel'#233'fono'#39', '
      '  u.email '#39'Mail'#39', '
      '  u.nro_moto '#39'Nro. Moto'#39', '
      '  u.nro_moto_cross '#39'Nro. Motocross'#39', '
      '  u.nro_cuatriciclo '#39'Nro. Cuatriciclo'#39','
      '  l.localidad as Localidad, '
      '  p.provincia as Provincia, '
      
        '  sel_nombre_categoria_by_categoria(null, u.oid) as '#39'Categor'#237'a'#39',' +
        ' '
      '  u.telefono_acompaniante '#39'Tel'#233'fono Acompa'#241'ante'#39', '
      '  mm.nombre '#39'Modelo Moto'#39', '
      '  u.tid '#39'Tag ID'#39', '
      '  u.ranking Ranking'
      'FROM piloto u'
      '     LEFT JOIN localidad l on u.localidad_oid = l.oid  '
      '     JOIN provincias p on l.provincia_oid = p.oid  '
      
        '     LEFT JOIN modelo_moto mm on mm.oid = u.modelo_moto_oid;    ' +
        ' ')
    Params = <>
    Left = 128
    Top = 408
  end
  object ZExportarNrosRepetidos: TZQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        '(select p.nro_moto '#39'Nro. Competidor'#39', GROUP_CONCAT(CONCAT(p.apel' +
        'lido, '#39', '#39', p.nombre) SEPARATOR '#39'/'#39') Piloto, count(p.nro_moto) C' +
        'antidad'
      'from piloto p'
      'where p.nro_moto > 0'
      'group by p.nro_moto'
      'having count(p.nro_moto) > 0)'
      'UNION'
      
        '(select p.nro_cuatriciclo, GROUP_CONCAT(CONCAT(p.apellido, '#39', '#39',' +
        ' p.nombre) SEPARATOR '#39'/'#39'), count(p.nro_cuatriciclo)'
      'from piloto p'
      'where p.nro_cuatriciclo > 0'
      'group by p.nro_cuatriciclo'
      'having count(p.nro_cuatriciclo) > 0)'
      'UNION'
      
        '(select p.nro_moto_cross, GROUP_CONCAT(CONCAT(p.apellido, '#39', '#39', ' +
        'p.nombre) SEPARATOR '#39'/'#39'), count(p.nro_moto_cross)'
      'from piloto p'
      'where p.nro_moto_cross > 0'
      'group by p.nro_moto_cross'
      'having count(p.nro_moto_cross) > 0)')
    Params = <>
    Properties.Strings = (
      'codepage=utf8')
    Left = 288
    Top = 376
  end
  object ZExportarTags: TZQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      
        'select p.tid '#39'Tag ID'#39', GROUP_CONCAT(CONCAT(p.apellido, '#39', '#39', p.n' +
        'ombre) SEPARATOR '#39'/'#39') Piloto, count(p.tid) Cantidad'
      'from piloto p'
      'group by p.tid'
      'having count(p.tid) > 0'
      'order by p.tid')
    Params = <>
    Properties.Strings = (
      'codepage=utf8')
    Left = 392
    Top = 376
  end
  object ZExportarMail: TZReadOnlyQuery
    Connection = ConnectionModule.ZConnection
    SQL.Strings = (
      'SELECT * FROM('
      'SELECT'
      '  CONCAT(apellido, '#39', '#39', nombre) Competidor, email '#39'Mail'#39
      'FROM piloto '
      'UNION'
      'SELECT'
      '  CONCAT(apellido, '#39', '#39', nombre) Competidor, email '#39'Mail'#39
      'FROM contacto) pyc'
      'order by Mail = '#39#39', Competidor, Mail')
    Params = <>
    Left = 128
    Top = 472
  end
