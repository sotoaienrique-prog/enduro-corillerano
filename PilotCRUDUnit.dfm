  inherited queryGrid: TZReadOnlyQuery
    SQL.Strings = (
      'SELECT'
      
        '  sel_nro_moto_by_categoria(null, u.oid) nro_moto, u.oid, u.nomb' +
        're, apellido, direccion, u.localidad_oid, telefono, telefono_fij' +
        'o, email, l.localidad as nombre_localidad, '
      
        '  p.provincia as nombre_provincia, u.nro_docu, u.fecha_nacimient' +
        'o, u.tid, '
      
        '  sel_nombre_categoria_by_categoria(null, u.oid) nombre_categori' +
        'a, u.ranking'
      'FROM piloto u'
      '     LEFT JOIN localidad l on u.localidad_oid = l.oid  '
      '     LEFT JOIN provincias p on l.provincia_oid = p.oid  '
      
        'where (:nombre is null or LENGTH(:nombre) = 0 or u.nombre LIKE C' +
        'ONCAT('#39'%'#39', :nombre, '#39'%'#39')) and'
      
        '      (:apellido is null or LENGTH(:apellido) = 0 or u.apellido ' +
        'LIKE CONCAT('#39'%'#39', :apellido, '#39'%'#39')) and'
      
        '      (:nro_docu is null or LENGTH(:nro_docu) = 0 or u.nro_docu ' +
        'LIKE CONCAT('#39'%'#39', :nro_docu, '#39'%'#39')) and'
      
        '      (:tid is null or LENGTH(:tid) = 0 or u.tid LIKE CONCAT('#39'%'#39 +
        ', :tid, '#39'%'#39')) and'
      '      (:categoria_oid is null or :categoria_oid = 0 or'
      ' CASE :tipo_categoria'
      '          WHEN  1 THEN u.categoria_oid'
      '          WHEN  2 THEN u.categoria_cuatriciclos_oid'
      
        '          WHEN  3 THEN u.categoria_motocross_oid                ' +
        '                '
      '          WHEN  4 THEN u.categoria_externa_oid'
      '     END = :categoria_oid) and '
      
        '     (:nro_moto is null or :nro_moto = 0 or sel_nro_moto_by_cate' +
        'goria_no_delimit(null, u.oid) like CONCAT('#39'%'#39', :nro_moto, '#39'%'#39'))')
    Params = <
      item
        DataType = ftUnknown
        Name = 'nombre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'apellido'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'nro_docu'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tid'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'categoria_oid'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipo_categoria'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'nro_moto'
        ParamType = ptUnknown
      end>
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'nombre'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'apellido'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'nro_docu'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tid'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'categoria_oid'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'tipo_categoria'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'nro_moto'
        ParamType = ptUnknown
      end>
  end
